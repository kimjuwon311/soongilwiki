modules = ["go-1.21", "nodejs-20", "web", "python-3.11", "go-1.23"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OpenNAMU Wiki"

[[workflows.workflow]]
name = "OpenNAMU Wiki"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NAMU_HOST=0.0.0.0 NAMU_PORT=5000 NAMU_GOLANGPORT=3001 NAMU_LANG=ko-KR NAMU_MARKUP=namumark NAMU_ENCRYPT=sha3 python app.py"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3002

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 42381
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "NAMU_HOST=0.0.0.0 NAMU_PORT=5000 NAMU_GOLANGPORT=3001 NAMU_LANG=ko-KR NAMU_MARKUP=namumark NAMU_ENCRYPT=sha3 python app.py"]
